# Production settings. Copy to infra/.env on the server (never commit .env).
DOMAIN=ngclass.example.tn
# Long random values: openssl rand -base64 32 / openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
# The teacher account, created on the first start only. She chooses her own password at first login.
TEACHER_USERNAME=
TEACHER_PASSWORD=
TEACHER_FIRST_NAME=
TEACHER_LAST_NAME=
# The platform owner, created on the first start only. Chooses a new password at first login, then adds teachers.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
