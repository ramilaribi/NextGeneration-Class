# Production settings. With ./infra/deploy.sh, make-env.sh writes infra/.env on the server (never commit .env).
# With the GitHub pipeline (.github/workflows/ci.yml, job "deploy"), the same names are repository variables
# and secrets instead, and no .env file is written (docs/04-delivery/05-DEPLOYMENT.md, "Two ways to deploy").
# The web address, already pointing at the server (DNS A record). Caddy gets the HTTPS certificate for it.
DOMAIN=ngclass.example.tn
# Long random values: openssl rand -base64 32 / openssl rand -base64 48
DB_PASSWORD=
JWT_SECRET=
# The owner's account (admin dashboard), created on the first start only. Asked to change the password at first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
# Optional: a first teacher account, created on the first start only. Otherwise add teachers from the dashboard.
TEACHER_USERNAME=
TEACHER_PASSWORD=
TEACHER_FIRST_NAME=
TEACHER_LAST_NAME=
# Optional: off-site copy of the nightly backup, an rclone remote and folder (docs/04-delivery/05-DEPLOYMENT.md).
BACKUP_REMOTE=
