{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8080
	}

	# For the uptime alert: answers "UP" only when the API and the database both work.
	handle /health {
		rewrite * /actuator/health
		reverse_proxy api:8080
	}

	# The Flutter web app: unknown paths fall back to index.html (client-side routes).
	handle {
		root * /srv
		try_files {path} /index.html
		# These files name the current version: never cached, so a new deploy reaches everyone on the next visit.
		@entry path / /index.html /flutter_bootstrap.js /flutter_service_worker.js /version.json /manifest.json
		header @entry Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No other site may show the platform inside a frame (clickjacking).
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		# The camera for the photo scan, from this site only; no microphone, no location.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}
}

# www.<domain> sends visitors to the main address. WWW_REDIRECT=off in infra/.env when this server is only the API
# (front on Cloudflare, docs/05-deployment/07-CLOUDFLARE.md): www.api.<domain> does not exist and would fail its certificate.
(www-on) {
	www.{$DOMAIN} {
		redir https://{$DOMAIN}{uri} permanent
	}
}
(www-off) {
}
import www-{$WWW_REDIRECT:on}
